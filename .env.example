# PromptDiet Environment Variables
# Copy this file to .env and fill in values as needed.

# ── Runtime Mode ──────────────────────────────────────────
ENVIRONMENT=local                        # "local" or "production"

# ── Backend ───────────────────────────────────────────────
PORT=7860                                # Server port (HF Spaces expects 7860)
CORS_ORIGINS=["http://localhost:5173"]   # JSON array of allowed origins

# ── SQLite (Local Mode) ──────────────────────────────────
SQLITE_PATH=data/promptdiet.db           # Relative to backend/

# ── Supabase (Cloud Mode — optional) ─────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-or-service-key

# ── Google Gemini API (Stage 3 Rewriter — optional) ──────
# GEMINI_API_KEY=your-google-ai-studio-api-key

# ── Pipeline Tuning ──────────────────────────────────────
LOG_CONTEXT_LINES=3                      # Lines of context to keep before errors
CACHE_PREFIX_RATIO=0.2                   # Fraction of prompt to scan for cache violations

